PORT=5000
CLIENT_URL=https://www.rafflesjobs.com
MONGO_URI=
# JWT_SECRET is mandatory in production (min 32 chars). A dev fallback exists for local runs.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Set to production on a real deployment — stack traces are hidden and the
# server refuses weak/default secrets only when this is "production".
NODE_ENV=development

# Public site origin, used to build absolute job/sitemap URLs
SITE_URL=https://www.rafflesjobs.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=465
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
# Optional alternative to SMTP credentials (see config/email.js)
BREVO_API_KEY=
EMAIL_FROM="Raffles Consultancy <noreply@rafflesconsultancy.com>"
# Set to 1 only when the SMTP host does not present a valid TLS certificate
# SMTP_INSECURE_TLS=1

# Admin login (POST /api/admin/login). Required in production — there is no
# built-in fallback passkey anymore.
ADMIN_EMAIL=
ADMIN_PASSKEY=

# Firebase Web API Key (public; also used as VITE_FIREBASE_API_KEY in client/.env)
FIREBASE_API_KEY=

# Reverse proxy: set to true / hop count / trust list only when behind a proxy
# TRUST_PROXY=1

# Google Indexing API (notifies Google immediately when jobs are published, updated, or closed)
GOOGLE_INDEXING_ENABLED=false
# Path to service account JSON key file or raw JSON credentials
GOOGLE_INDEXING_SERVICE_ACCOUNT=

# Rate limiting (in-memory, per IP). Every value is optional.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_SEND_OTP_MAX=5
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_ADMIN_LOGIN_MAX=5
RATE_LIMIT_GOOGLE_AUTH_MAX=10
